# Copiar como .env en el servidor (fuera de git) y completar con valores reales.
# En local (dev en Windows) tu backend/.env actual ya funciona tal cual está;
# estas variables nuevas son opcionales ahí — sin definirlas, el proyecto
# se comporta permisivo (como hasta ahora).

# --- Base de datos (Postgres ya en tu servidor) ---
DATABASE_URL="postgresql://usuario:password@host:puerto/nombre_bd?sslmode=disable"

# --- Django ---
SECRET_KEY="generar-una-clave-larga-y-random-para-produccion"
DEBUG=False

# --- DeepSeek (opcional — sin key, cae al respaldo local sin IA real) ---
DEEPSEEK_API_KEY=""

# --- Producción: dominios permitidos ---
# Dominio/host por el que se accede al backend (el que ve Nginx)
ALLOWED_HOSTS=url.dom.com.ec,localhost

# Origen exacto del frontend en Vercel (con https://, sin barra final).
# Podés poner varios separados por coma si tenés preview deployments.
CORS_ALLOWED_ORIGINS=https://tu-proyecto.vercel.app

# Mismo origen del frontend — lo pide Django para aceptar POST/PUT vía CSRF
# si en algún momento se usa SessionAuthentication en vez de JWT puro.
CSRF_TRUSTED_ORIGINS=https://tu-proyecto.vercel.app
