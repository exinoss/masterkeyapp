// Jenkinsfile — MasterKey Backend
// Misma convención que RememberGo: el .env real vive como credencial
// "Secret file" en Jenkins (Manage Jenkins → Credentials), nunca en git.
// Creá una con id "masterkey-env" y el contenido de backend/.env.example
// ya completado con los valores reales.
pipeline {
    agent any

    stages {

        stage('Deploy') {
            steps {
                dir('backend') {
                    withCredentials([file(credentialsId: 'masterkey-env', variable: 'MASTERKEY_ENV_FILE')]) {
                        sh '''
                            # Copiar las credenciales seguras al archivo .env
                            cp "$MASTERKEY_ENV_FILE" .env

                            # Apagar contenedores anteriores limpiando huérfanos
                            docker compose down --remove-orphans || true

                            # Recompilar y levantar los servicios
                            docker compose up -d --build
                        '''
                    }
                }
            }
        }

        stage('Verificar salud') {
            steps {
                dir('backend') {
                    sh '''
                        for i in $(seq 1 10); do
                            if docker compose exec -T masterkey_backend python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')"; then
                                echo "Backend saludable."
                                exit 0
                            fi
                            echo "Esperando que el backend levante... ($i/10)"
                            sleep 3
                        done
                        echo "El backend no respondió /health a tiempo."
                        docker compose logs --tail=100 masterkey_backend
                        exit 1
                    '''
                }
            }
        }

        // Sin acceso SSH al servidor, esto es la única forma de ver el
        // estado real de los contenedores (en particular nginx_ssl, que
        // el healthcheck de arriba no chequea). Corre siempre, no rompe
        // el build si algo de esto falla.
        stage('Diagnóstico') {
            steps {
                dir('backend') {
                    sh '''
                        echo "--- docker compose ps ---"
                        docker compose ps || true
                        echo "--- logs nginx_ssl (últimas 80 líneas) ---"
                        docker compose logs --tail=80 nginx_ssl || true
                        echo "--- quién corre nginx y puede escribir /run ---"
                        docker compose run --rm --no-deps --entrypoint sh nginx_ssl -c \
                          "id; ls -ld /run; (touch /run/prueba && echo WRITE_OK) || echo WRITE_FALLO" || true
                        echo "--- curl local al puerto publicado ---"
                        curl -sk -o /dev/null -w "status: %{http_code}\\n" https://localhost:9616/health || true
                    '''
                }
            }
        }
    }

    post {
        failure {
            echo 'El deploy falló — revisá los logs de la etapa que rompió.'
        }
        always {
            // No dejar el .env real (con secretos) tirado en el workspace.
            dir('backend') {
                sh 'rm -f .env'
            }
        }
    }
}
